[Unit]
Description=Flow Dashboard (Gunicorn)
After=network.target

[Service]
User=yuheng
WorkingDirectory=/home/yuheng/ryu-project
Environment="PATH=/home/yuheng/ryu-project/venv/bin"
ExecStart=/home/yuheng/ryu-project/venv/bin/gunicorn -w 2 -b 127.0.0.1:5000 server:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
