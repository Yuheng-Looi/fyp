server {
    listen 80;
    listen [::]:80;
    server_name 203.80.21.40 10.100.10.131 _;

    # Serve the dashboard directly as static
    root /home/yuheng/fyp/frontend;
    index dashboard.html;

    location / {
        try_files $uri $uri/ /dashboard.html @flow_backend;
    }

    # Static assets if you add any later
    location /static/ {
        alias /home/yuheng/fyp/frontend;
        autoindex off;
    }

    # Proxy everything else (API, uploads, etc.) to Flask on localhost:5000
    location @flow_backend {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:5000;
        client_max_body_size 200m;  # allow large pcaps
    }
}
